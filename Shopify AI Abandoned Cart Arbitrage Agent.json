    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\n\nconst checkout = body.checkout || body;\n\nconst customerPhone = checkout.phone || \n                      checkout.billing_address?.phone || \n                      checkout.shipping_address?.phone || null;\n\nconst customerEmail = checkout.email || null;\nconst customerFirstName = checkout.billing_address?.first_name || \n                          checkout.shipping_address?.first_name || \n                          checkout.customer?.first_name || 'Friend';\n\nconst lineItems = checkout.line_items || [];\nconst cartItems = lineItems.map(item => ({\n  name: item.title || item.name,\n  quantity: item.quantity,\n  price: item.price,\n  variant: item.variant_title || ''\n}));\n\nconst cartTotal = checkout.total_price || checkout.subtotal_price || '0.00';\nconst checkoutId = checkout.id || checkout.token;\nconst checkoutToken = checkout.token || checkout.id;\nconst currency = checkout.currency || 'USD';\n\nif (!customerPhone && !customerEmail) {\n  return [{ json: { skip: true, reason: 'No contact info available' } }];\n}\n\nif (cartItems.length === 0) {\n  return [{ json: { skip: true, reason: 'Empty cart' } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    checkoutId,\n    checkoutToken,\n    customerPhone,\n    customerEmail,\n    customerFirstName,\n    cartItems,\n    cartTotal,\n    currency,\n    cartItemsText: cartItems.map(i => `${i.quantity}x ${i.name}${i.variant ? ' (' + i.variant + ')' : ''}`).join(', ')\n  }\n}];"
      },
      "id": "7d5131f3-26ec-4e70-9ba0-f5c6bc25588f",
      "name": "Extract Checkout Data",
