    {
      "parameters": {
        "jsCode": "console.log('✅ Abandoned Cart Recovery Complete!');\nconsole.log('Customer:', $('Prepare WhatsApp Message').item.json.customerFirstName);\nconsole.log('Cart:', $('Prepare WhatsApp Message').item.json.cartItemsText);\nconsole.log('Discount Code:', $('Prepare WhatsApp Message').item.json.discountCode);\nconsole.log('WhatsApp sent to:', $('Prepare WhatsApp Message').item.json.formattedPhone);\n\nreturn [{\n  json: {\n    status: 'success',\n    message: 'Recovery workflow completed',\n    customer: $('Prepare WhatsApp Message').item.json.customerFirstName,\n    discountCode: $('Prepare WhatsApp Message').item.json.discountCode,\n    whatsappSentTo: $('Prepare WhatsApp Message').item.json.formattedPhone,\n    timestamp: new Date().toISOString()\n  }\n}];"
