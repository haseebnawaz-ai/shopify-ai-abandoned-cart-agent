        "jsCode": "const ordersData = $input.first().json;\nconst orders = ordersData.orders || [];\n\nif (orders.length > 0) {\n  return [{ json: { alreadyPaid: true, reason: 'Customer already completed purchase' } }];\n}\n\nreturn [{ json: { alreadyPaid: false } }];"
