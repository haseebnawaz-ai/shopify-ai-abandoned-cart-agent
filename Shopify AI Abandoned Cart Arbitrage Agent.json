    {
      "parameters": {
        "jsCode": "const groqResponse = $input.first().json;\nconst aiMessage = groqResponse.choices[0].message.content.trim();\n\nconst checkoutData = $('Extract Checkout Data').item.json;\nconst discountCode = $('Generate Discount Code').item.json.discount_code.code;\n\nconst phone = checkoutData.customerPhone;\nlet formattedPhone = phone ? phone.replace(/[\\s\\-\\(\\)\\+]/g, '') : null;\nif (formattedPhone && !formattedPhone.startsWith('92') && !formattedPhone.startsWith('+')) {\n  formattedPhone = '92' + formattedPhone.replace(/^0/, '');\n}\n\nreturn [{\n  json: {\n    aiMessage,\n    discountCode,\n    formattedPhone,\n    customerFirstName: checkoutData.customerFirstName,\n    cartItemsText: checkoutData.cartItemsText,\n    checkoutId: checkoutData.checkoutId\n  }\n}];"
      },
