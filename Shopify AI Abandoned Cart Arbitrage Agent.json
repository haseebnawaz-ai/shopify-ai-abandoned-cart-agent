        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama-3.3-70b-versatile"
            },
            {
              "name": "messages",
              "value": "=[\n  {\n    \"role\": \"system\",\n    \"content\": \"You are a friendly gym equipment sales assistant. Write short, natural WhatsApp messages (max 3 lines). Sound like a helpful friend, NOT a salesman. Be genuine and casual. Never use emojis excessively. Always mention the specific product they left behind.\"\n  },\n  {\n    \"role\": \"user\",\n    \"content\": \"Write a WhatsApp recovery message for: Customer Name: {{ $('Extract Checkout Data').item.json.customerFirstName }}, Left in cart: {{ $('Extract Checkout Data').item.json.cartItemsText }}, Cart Total: {{ $('Extract Checkout Data').item.json.currency }} {{ $('Extract Checkout Data').item.json.cartTotal }}, Discount Code: {{ $('Generate Discount Code').item.json.discount_code.code }} (10% off, expires in 24 hours). Keep it under 3 lines, casual English, end with the discount code naturally.\"\n  }\n]"
            },
            {
              "name": "max_tokens",
              "value": 200
            },
            {
              "name": "temperature",
              "value": 0.7
            }
          ]
        },
        "options": {}
      },
      "id": "d0a1a4a3-e892-4b55-a904-9fecaa3f5afe",
      "name": "Groq AI - Generate Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
